  "commit": "5535e31a712343a63f5d7d796cd874e563e5ac14",
  "adaptation": {
    "file": "base/ntos/rtl/arm64/unwind.c",
    "changes": [
      "XP public type/include adaptation; no CLR/DAC classes",
      "removed Windows private frame definitions and custom decoder",
      "explicitly reject private/custom opcodes, end_c and unimplemented encodings",
      "bounded image and stack reads; restored-register index validation",
      "propagate LR restore errors; require END; validate packed register counts",
      "validate PE function metadata and selected prolog/epilog streams",
      "commit context and result only on success",
      "Expose effective control PC, function bounds and normalized frame SP to the owned static-frame C dispatcher"
    ],
    "scope": "baseline public ARM64 PE metadata; not full SEH or a claim that every upstream feature was ported"
  }
